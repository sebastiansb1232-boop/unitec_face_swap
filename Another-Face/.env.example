# Solo servidor; no subir .env al repositorio.
PORT=3000
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=
# Alternativa si el proyecto todavía utiliza la clave heredada:
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
# Usar una contraseña única de al menos 16 caracteres:
ADMIN_PASSWORD=

# Motor local por defecto. En Render utiliza la URL HTTPS del túnel:
ANOTHERFACE_AI_URL=http://127.0.0.1:8766
# En Render, copia solo el valor generado en .env.ai de la PC servidora:
ANOTHERFACE_AI_TOKEN=
